{
  "manifest_version": 3,
  "name": "ChatGPT 提示词助手",
  "version": "1.1.0",
  "description": "在 ChatGPT 页面本地管理并插入常用提示词。",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "constants.js",
        "storage.js",
        "prompt-engine.js",
        "chatgpt-editor.js",
        "update-check.js",
        "ui.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
